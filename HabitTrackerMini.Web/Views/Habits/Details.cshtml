@model HabitTrackerMini.Services.Models.HabitDetails
@{
    ViewData["Title"] = Model.Habit.Name;
}

<a asp-action="Index" class="d-inline-block mb-3">Към моите навици</a>
<h1>@Model.Habit.Name</h1>
<p class="text-muted">@Model.Habit.Category · @(Model.Habit.IsActive ? "Активен" : "Неактивен")</p>

@if (!string.IsNullOrWhiteSpace(Model.Habit.Description))
{
    <p>@Model.Habit.Description</p>
}

@if (TempData["CompletionMessage"] is string message)
{
    <div class="alert alert-info" role="status">@message</div>
}

<section class="mb-4">
    <h2 class="h4">Напредък тази седмица</h2>
    <p class="text-muted">@Model.WeekStart.ToString("dd.MM.yyyy") – @Model.WeekStart.AddDays(6).ToString("dd.MM.yyyy")</p>
    <p><strong>@Model.DaysCompleted / @Model.Habit.WeeklyGoal</strong> изпълнени дни</p>

    @if (Model.CompletedToday)
    {
        <p>Отбелязан за днес.</p>
    }
    else if (Model.Habit.IsActive)
    {
        <form asp-action="Complete" asp-route-id="@Model.Habit.Id" method="post">
            <button type="submit" class="btn btn-primary">Отбележи за днес</button>
        </form>
    }
</section>

<section>
    <h2 class="h4">История на изпълненията</h2>
    @if (Model.CompletionDates.Count == 0)
    {
        <p>Все още няма отбелязани дни.</p>
    }
    else
    {
        <ul>
            @foreach (var date in Model.CompletionDates)
            {
                <li><time datetime="@date.ToString("yyyy-MM-dd")">@date.ToString("dd.MM.yyyy")</time></li>
            }
        </ul>
    }
</section>
