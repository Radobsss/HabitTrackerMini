@model HabitsIndexViewModel
@{
    ViewData["Title"] = "Моите навици";
}

<div class="d-flex flex-wrap gap-3 justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Моите навици</h1>
    <a asp-action="Create" class="btn btn-primary">Добави навик</a>
</div>

@if (Model.Habits.Count == 0)
{
    <p>Все още няма добавени навици.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col">ID</th>
                    <th scope="col">Име</th>
                    <th scope="col">Категория</th>
                    <th scope="col">Седмична цел</th>
                    <th scope="col">Статус</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var habit in Model.Habits)
                {
                    <tr>
                        <td>@habit.Id</td>
                        <th scope="row">
                            <a asp-action="Details" asp-route-id="@habit.Id">@habit.Name</a>
                        </th>
                        <td>@habit.Category</td>
                        <td>@habit.WeeklyGoal дни</td>
                        <td>@(habit.IsActive ? "Активен" : "Неактивен")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
