@{
    ViewData["Title"] = "Добавяне на навик";
}

<h1>Добавяне на навик</h1>

<form>
    <div class="mb-3">
        <label>Име</label>
        <input type="text" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Категория</label>
        <input type="text" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Седмична цел</label>
        <input type="number" min="1" max="7"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Описание</label>
        <textarea class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label>Активен</label>
        <input type="checkbox" />
    </div>

    <button type="submit" class="btn btn-success">
        Запази
    </button>
</form>
